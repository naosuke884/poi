{
  "name": "poi",
  "version": "0.1.0",
  "private": true,
  "description": "A memo pad that forgets: notes that disappear 30 days after you write them. One Cloudflare Worker + D1.",
  "homepage": "https://github.com/naosuke884/poi#readme",
  "bugs": "https://github.com/naosuke884/poi/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naosuke884/poi.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "npm run build && vp preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "wrangler types && tsc --build",
    "test": "vp test run",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "cf-typegen": "wrangler types",
    "auth:schema": "npx auth@1.7.7 generate --config better-auth.config.ts --output worker/auth/schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply poi --local",
    "db:migrate:remote": "wrangler d1 migrations apply poi --remote",
    "prepare": "husky",
    "test:a11y": "playwright test",
    "lint:jev": "jev-lint check"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@lezer/markdown": "^1.8.0",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.5.2",
    "@tanstack/react-router": "^1.170.45",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "~1.64.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "jev-lint": "^0.7.0",
    "jsdom": "^30.1.3",
    "playwright-core": "~1.64.0",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plus": "1.4.0",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "miniflare": {
      "undici": "^7.30.1"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "24"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260826.1": true,
    "esbuild@0.25.12": true
  }
}
