{
  "name": "poi",
  "private": true,
  "description": "A memo pad that forgets: notes that disappear 30 days after you write them. One Cloudflare Worker + D1.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naosuke884/poi.git"
  },
  "homepage": "https://github.com/naosuke884/poi#readme",
  "bugs": "https://github.com/naosuke884/poi/issues",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "wrangler types && tsc --build",
    "cf-typegen": "wrangler types",
    "auth:schema": "npx auth@1.7.2 generate --config better-auth.config.ts --output worker/db/schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply poi --local",
    "db:migrate:remote": "wrangler d1 migrations apply poi --remote"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@lezer/markdown": "^1.7.2",
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@tanstack/react-router": "^1.170.32",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "modern-screenshot": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.127.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260826.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
