{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poi",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /__scheduled は `wrangler dev --test-scheduled` で Cron をローカル実行するための経路。
    // 静的アセット (SPA フォールバック) より先に Worker に渡さないと届かないのでここに含める
    // (本番では Worker の notFound → SPA フォールバックになるだけで動作は変わらない)
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poi",
      // `wrangler d1 create poi` の出力で置き換える (ローカル開発だけならこのままでも動く)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  // 期限切れメモの物理削除 (worker/index.ts の scheduled ハンドラ) を毎時 0 分に実行する
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
