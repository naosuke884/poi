{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poi",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /__scheduled は `wrangler dev --test-scheduled` で Cron をローカル実行するための経路。
    // 静的アセット (SPA フォールバック) より先に Worker に渡さないと届かないのでここに含める
    // (本番では Worker の notFound → SPA フォールバックになるだけで動作は変わらない)
    "run_worker_first": ["/api/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poi",
      // メンテナの本番 D1 の id。セルフホストするときは `npx wrangler d1 create poi` で作った自分の id に置き換える (README 参照)
      "database_id": "95b1e126-5ae4-418a-8b4f-0c9de8c4533d",
      "migrations_dir": "drizzle"
    }
  ],
  // 期限切れメモの物理削除 (worker/index.ts の scheduled ハンドラ) を毎時 0 分に実行する
  "triggers": {
    "crons": ["0 * * * *"]
  },
  // メンテナの本番ドメイン (ゾーンが同じアカウントにあること)。入口を 1 つにするため workers.dev の URL は無効化している。
  // セルフホストするときは自分のドメインに置き換えるか、routes を消して workers_dev を true にする (README 参照)
  "routes": [{ "pattern": "poinote.app", "custom_domain": true }],
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
