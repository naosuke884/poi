{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!src/routeTree.gen.ts", "!worker/auth/schema.ts", "!drizzle", "!public"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/routes/**", "@/routes/**"],
                "message": "src/routes の外 (src/components, src/lib など) からルートの部品を import しない。共有するなら src/components / src/lib へ移す (route-colocation skill)"
              },
              {
                "group": [
                  "**/-components/**",
                  "!./-components/**",
                  "!../-components/**",
                  "!../../-components/**",
                  "!../../../-components/**",
                  "!../../../../-components/**",
                  "!../../../../../-components/**",
                  "!./-root/-components/**",
                  "**/-lib/**",
                  "!./-lib/**",
                  "!../-lib/**",
                  "!../../-lib/**",
                  "!../../../-lib/**",
                  "!../../../../-lib/**",
                  "!../../../../../-lib/**",
                  "!./-root/-lib/**"
                ],
                "message": "別のルートのディレクトリの -components / -lib を import しない (自分か祖先のルートのものだけ使える)。複数のルートで使うなら src/components / src/lib へ移す (route-colocation skill)"
              }
            ]
          }
        }
      },
      "suspicious": {
        "noImplicitAnyLet": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
