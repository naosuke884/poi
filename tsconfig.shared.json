{
  // src (ブラウザ) と worker (Workers) の両方で使うコード。どちらでも動くよう、DOM や Workers の型を入れない
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/shared-types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.shared.tsbuildinfo"
  },
  "include": ["shared"]
}
