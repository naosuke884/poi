{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poi",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    // 静的アセットに無いパスは Worker に渡す (worker/site/pages.ts が index.html を返し、知らないパスは 404 にする)。
    // "single-page-application" だと存在しないパスにも index.html を 200 で返してしまう (ソフト 404。issue #141)
    "not_found_handling": "none",
    // /index.html・/landing.html を / や /landing へ転送しない (既定の auto-trailing-slash は転送する)。
    // Service Worker の precache は /index.html を取りに行くが、転送されると / (Worker) がランディング
    // (landing.html) を返し、板などのページの代わりに出る空の HTML がランディングになってしまう (issue #157)
    "html_handling": "none",
    // /__scheduled は `wrangler dev --test-scheduled` で Cron をローカル実行するための経路。
    // 静的アセット (SPA フォールバック) より先に Worker に渡さないと届かないのでここに含める
    // (本番では Worker の notFound → SPA フォールバックになるだけで動作は変わらない)
    // / は、ログイン済み (セッション Cookie がある) なら板 (/board) へ 302 で転送するため Worker を通す
    // (worker/site/pages.ts。issue #156)。パターンはパス全体との一致なので /* ではなく / だけに効く
    "run_worker_first": ["/", "/api/*", "/__scheduled"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poi",
      // メンテナの本番 D1 の id。セルフホストするときは `npx wrangler d1 create poi` で作った自分の id に置き換え、
      // `npm run db:migrate:remote` でマイグレーションを適用する。Secrets (BETTER_AUTH_SECRET / GOOGLE_CLIENT_ID /
      // GOOGLE_CLIENT_SECRET。.dev.vars.example と同じ名前) は `npx wrangler secret put <名前>` で登録し、
      // Google の OAuth クライアントに `https://<ドメイン>/api/auth/callback/google` を redirect URI として追加する
      "database_id": "95b1e126-5ae4-418a-8b4f-0c9de8c4533d",
      "migrations_dir": "drizzle",
    },
  ],
  // 期限切れメモの物理削除 (worker/index.ts の scheduled ハンドラ) を毎時 0 分に実行する
  "triggers": {
    "crons": ["0 * * * *"],
  },
  // メンテナの本番ドメイン (ゾーンが同じアカウントにあること)。入口を 1 つにするため workers.dev の URL は無効化している。
  // セルフホストするときは自分のドメインに置き換えるか、routes を消して workers_dev を true にする
  "routes": [{ "pattern": "poinote.app", "custom_domain": true }],
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
}
